{
    "schemaVersion":  1,
    "id":  "com.ispconfig.liquid.theme",
    "name":  "ISPConfig LIQUID",
    "version":  "1.1.4-rc.1",
    "stage":  "release-candidate",
    "releaseDate":  "2026-07-30",
    "compatibility":  {
                          "ispconfig":  "3.3.1p1",
                          "preview":  "Ubuntu 22.04/24.04 and Debian 12/13, Apache and Nginx"
                      },
    "packageDirectory":  "liquid",
    "releaseTag":  "v1.1.4-rc.1",
    "design":  {
                   "family":  "liquid-glass",
                   "defaultMode":  "dark",
                   "defaultAccent":  "#6c63ff",
                   "secondaryAccent":  "#00d4ff"
               },
    "supportedModules":  [
                             "login",
                             "dashboard",
                             "help",
                             "client",
                             "sites",
                             "mail",
                             "mailuser",
                             "dns",
                             "monitor",
                             "tools",
                             "admin"
                         ],
    "retiredThemeSurfaces":  [
                                 "openvz",
                                 "aps-installer",
                                 "mailman-2",
                                 "xmpp"
                             ],
    "boundaries":  {
                       "themeOnly":  true,
                       "coreReimplementation":  false,
                       "productionDeploymentApproved":  false,
                       "nextThemeDependency":  false
                   },
    "distributionMode":  "standalone-theme",
    "optionalIntegration":  {
                                "Name":  "ISPConfig LIQUID branding",
                                "Required":  false,
                                "BehaviorWithoutIntegration":  "Theme-local ISPConfig logo, favicon and violet accent defaults"
                            }
}
